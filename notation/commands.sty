% Young Tableaux for 1 epsdot and 1 eps:
\newcommand{\yTeps}[4]{
	\ytableausetup{centertableaux, mathmode, nosmalltableaux}  % , smalltableaux
	\ensuremath{
		\overline{
			\begin{ytableau}
				\scriptstyle #1 \\
				\scriptstyle #2
			\end{ytableau}
		}
		\otimes
		\begin{ytableau}
			\scriptstyle #3 \\
			\scriptstyle #4
		\end{ytableau}
		% small space after the tableau
		\ %
		\ytableausetup{smalltableaux}
	}
}

\newcommand{\yTepsLarge}[4]{
	\ytableausetup{centertableaux, mathmode, nosmalltableaux}  % , smalltableaux
	\ensuremath{
		\overline{
			\begin{ytableau}
				#1 \\
				#2
			\end{ytableau}
		}
		\otimes
		\begin{ytableau}
			#3 \\
			#4
		\end{ytableau}
		% small space after the tableau
		\ %
		\ytableausetup{smalltableaux}
	}
}

% Young Tableaux for 1 epsdot and 2 eps:
\newcommand{\yTonetwoeps}[6]{
	\ytableausetup{centertableaux, mathmode, nosmalltableaux}  % , smalltableaux
	\ensuremath{
		\overline{
			\begin{ytableau}
				#1 \\
				#2
			\end{ytableau}
		}
		\otimes
		\begin{ytableau}
			#3 & #5\\
			#4 & #6
		\end{ytableau}
		% small space after the tableau
		\ %
		\ytableausetup{smalltableaux}
	}
}

\newcommand{\yTtwoeps}[4]{
	\ytableausetup{centertableaux, mathmode, nosmalltableaux}
	\ensuremath{
		\begin{ytableau}
			#1 & #3\\
			#2 & #4
		\end{ytableau}
		% small space after the tableau
		%		\ %
		\ytableausetup{smalltableaux}
	}
}

