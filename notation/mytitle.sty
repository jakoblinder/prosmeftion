% !TeX root = main.tex
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mytitle}[2023/04/28 v.01 package containing the title]
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}

% Adjust footer of first (title) page
\fancypagestyle{plain}{%
	\fancyhf{}
	\renewcommand{\headrulewidth}{0pt}
	\renewcommand{\footrulewidth}{0pt}
	\fancyfoot[LE,RO]{\thepage\ of\ \pageref{LastPage}}
}

\newcommand*{\project}[1]{\gdef\@project{#1}%
}
\newcommand*{\@project}{Some project} % "Final Year Project" is written if no \project is set.

\newcommand*{\organisation}[1]{\gdef\@organisation{#1}%
}
\newcommand*{\@organisation}{RWTH University}

\def\@maketitle{%
	\newpage
	\null
	\vspace*{-2em}
%	\vskip 2em%
	\begin{center}%
		\let \footnote \thanks
		{{\LARGE \bfseries \@title \unskip\strut}\par}%
		{{\large \@project \unskip\strut}\par}%
		\vskip 1.5em%
		{\large
			\lineskip .5em%
			\begin{tabular}[t]{c}%
				\@author
			\end{tabular}\par}%
		\vskip 1em%
		{\large \@date}%
	\end{center}%
	\par
}%

