 file = {Fonseca-2020-Enumerating-the-operators-of-an-eff:Attachments/Fonseca-2020-Enumerating-the-operators-of-an-eff.pdf:application/pdf;Fonseca-2020-Enumerating-the-operators-of-an-eff (2):Attachments/Fonseca-2020-Enumerating-the-operators-of-an-eff (2).pdf:application/pdf;Fonseca 2020 - Enumerating the operators:Attachments/Fonseca 2020 - Enumerating the operators.pdf:application/pdf}
