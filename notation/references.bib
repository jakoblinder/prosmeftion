@article{Boeck,
 abstract = {Let {\$}s{\_}$\backslash$nu $\backslash$circ s{\_}$\backslash$mu{\$} denote the plethystic product of the Schur functions {\$}s{\_}$\backslash$nu{\$} and {\$}s{\_}$\backslash$mu{\$}. In this article we define an explicit polynomial representation corresponding to {\$}s{\_}$\backslash$nu $\backslash$circ s{\_}$\backslash$mu{\$} with basis indexed by certain `plethystic' semistandard tableaux. Using these representations we prove generalizations of four results on plethysms due to Bruns--Conca--Varbaro, Brion, Ikenmeyer and the authors. In particular, we give a sufficient condition for the multiplicity {\$}\langle s{\_}$\backslash$nu $\backslash$circ s{\_}$\backslash$mu, s{\_}\lambda$\backslash$rangle{\$} to be stable under insertion of new parts into {\$}$\backslash$mu{\$} and {\$}\lambda{\$}. We also characterize all maximal and minimal partitions {\$}\lambda{\$} in the dominance order such that {\$}s{\_}\lambda{\$} appears in {\$}s{\_}$\backslash$nu $\backslash$circ s{\_}$\backslash$mu{\$} and determine the corresponding multiplicities using plethystic semistandard tableaux.},
 author = {Boeck, Melanie de and Paget, Rowena and Wildon, Mark},
 title = {Plethysms of symmetric functions and highest weight representations},
 keywords = {Mathematics - Combinatorics;Mathematics - Representation Theory},
 eprint = {1810.03448v2},
 issuetitle = {math.RT}
}


